@model BuckScience.Web.ViewModels.Photos.PropertyPhotosVm
@{
    ViewData["Title"] = $"Photos - {Model.PropertyName}";
    
    string GetSortUrl(string sortValue)
    {
        var query = new List<string> { $"sort={sortValue}" };
        if (Model.AppliedFilters != null)
        {
            if (Model.AppliedFilters.DateTakenFrom.HasValue)    query.Add($"dateTakenFrom={Model.AppliedFilters.DateTakenFrom.Value:yyyy-MM-dd}");
            if (Model.AppliedFilters.DateTakenTo.HasValue)      query.Add($"dateTakenTo={Model.AppliedFilters.DateTakenTo.Value:yyyy-MM-dd}");
            if (Model.AppliedFilters.DateUploadedFrom.HasValue) query.Add($"dateUploadedFrom={Model.AppliedFilters.DateUploadedFrom.Value:yyyy-MM-dd}");
            if (Model.AppliedFilters.DateUploadedTo.HasValue)   query.Add($"dateUploadedTo={Model.AppliedFilters.DateUploadedTo.Value:yyyy-MM-dd}");
            if (Model.AppliedFilters.CameraIds?.Count > 0)      query.Add($"cameras={string.Join(",", Model.AppliedFilters.CameraIds)}");
            if (Model.AppliedFilters.TemperatureMin.HasValue)   query.Add($"tempMin={Model.AppliedFilters.TemperatureMin}");
            if (Model.AppliedFilters.TemperatureMax.HasValue)   query.Add($"tempMax={Model.AppliedFilters.TemperatureMax}");
            if (Model.AppliedFilters.WindSpeedMin.HasValue)     query.Add($"windSpeedMin={Model.AppliedFilters.WindSpeedMin}");
            if (Model.AppliedFilters.WindSpeedMax.HasValue)     query.Add($"windSpeedMax={Model.AppliedFilters.WindSpeedMax}");
            if (Model.AppliedFilters.HumidityMin.HasValue)      query.Add($"humidityMin={Model.AppliedFilters.HumidityMin}");
            if (Model.AppliedFilters.HumidityMax.HasValue)      query.Add($"humidityMax={Model.AppliedFilters.HumidityMax}");
            if (Model.AppliedFilters.PressureMin.HasValue)      query.Add($"pressureMin={Model.AppliedFilters.PressureMin}");
            if (Model.AppliedFilters.PressureMax.HasValue)      query.Add($"pressureMax={Model.AppliedFilters.PressureMax}");
            if (Model.AppliedFilters.VisibilityMin.HasValue)    query.Add($"visibilityMin={Model.AppliedFilters.VisibilityMin}");
            if (Model.AppliedFilters.VisibilityMax.HasValue)    query.Add($"visibilityMax={Model.AppliedFilters.VisibilityMax}");
            if (Model.AppliedFilters.CloudCoverMin.HasValue)    query.Add($"cloudCoverMin={Model.AppliedFilters.CloudCoverMin}");
            if (Model.AppliedFilters.CloudCoverMax.HasValue)    query.Add($"cloudCoverMax={Model.AppliedFilters.CloudCoverMax}");
            if (Model.AppliedFilters.MoonPhaseTexts?.Count > 0) query.Add($"moonPhaseTexts={string.Join(",", Model.AppliedFilters.MoonPhaseTexts)}");
            if (Model.AppliedFilters.Conditions?.Count > 0)     query.Add($"conditions={string.Join(",", Model.AppliedFilters.Conditions)}");
            if (Model.AppliedFilters.WindDirectionTexts?.Count > 0) query.Add($"windDirections={string.Join(",", Model.AppliedFilters.WindDirectionTexts)}");
            if (Model.AppliedFilters.TimeOfDayStart.HasValue)   query.Add($"timeOfDayStart={Model.AppliedFilters.TimeOfDayStart}");
            if (Model.AppliedFilters.TimeOfDayEnd.HasValue)     query.Add($"timeOfDayEnd={Model.AppliedFilters.TimeOfDayEnd}");
        }
        return "?" + string.Join("&", query);
    }
}

<div class="photos-page">

    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="sidebar-title mb-0">@Model.PropertyName</h2>
        <a href="/properties/@Model.PropertyId/cameras" class="btn btn-custom-cancel btn-sm">
            <i class="fas fa-camera me-1"></i>Cameras
        </a>
    </div>
    <hr class="sidebar-title-separator" />

@if (Model.TotalPhotoCount == 0)
{
    <div class="photos-empty">
        <i class="fas fa-camera"></i>
        <h3>No photos yet</h3>
        <p>Upload photos from your cameras to get started.</p>
        <a href="/properties/@Model.PropertyId/cameras" class="btn btn-custom-primary mt-2">
            <i class="fas fa-camera me-2"></i>Manage Cameras
        </a>
    </div>
}
else
{
    <!-- Filter Bar -->
    <div class="filter-bar mb-3">
        <div class="filter-bar-header" data-bs-toggle="collapse" data-bs-target="#filtersPanel" aria-expanded="false">
            <span class="filter-bar-toggle">
                <i class="fas fa-sliders-h"></i>
                Filters
                @if (Model.HasFiltersApplied)
                {
                    <span class="filter-active-badge">Active</span>
                }
            </span>
            <div class="filter-bar-actions">
                @if (Model.HasFiltersApplied)
                {
                    <a href="/properties/@Model.PropertyId/photos?sort=@Model.CurrentSort"
                       class="btn btn-outline-secondary btn-sm"
                       onclick="event.stopPropagation()">
                        <i class="fas fa-times me-1"></i>Clear
                    </a>
                }
                <i class="fas fa-chevron-down filter-chevron" id="filterChevron"></i>
            </div>
        </div>

        <div class="collapse" id="filtersPanel">
            <div class="filter-panel">
                <form id="photoFiltersForm" method="get">
                    <input type="hidden" name="sort" value="@Model.CurrentSort" />

                    <!-- Quick filters -->
                    <div class="filter-section-label"><i class="fas fa-bolt"></i>Quick</div>
                    <div class="quick-filters mb-3">
                        <a href="/properties/@Model.PropertyId/photos?sort=@Model.CurrentSort&quickFilter=day"
                           class="filter-chip @(ViewContext.HttpContext.Request.Query["quickFilter"] == "day" ? "active" : "")">
                            <i class="fas fa-sun"></i>Day
                        </a>
                        <a href="/properties/@Model.PropertyId/photos?sort=@Model.CurrentSort&quickFilter=night"
                           class="filter-chip @(ViewContext.HttpContext.Request.Query["quickFilter"] == "night" ? "active" : "")">
                            <i class="fas fa-moon"></i>Night
                        </a>
                        @if (ViewContext.HttpContext.Request.Query["quickFilter"].ToString() != "")
                        {
                            <a href="/properties/@Model.PropertyId/photos?sort=@Model.CurrentSort" class="filter-chip">
                                <i class="fas fa-times"></i>Clear
                            </a>
                        }
                    </div>

                    <hr class="filter-divider" />

                    <!-- Date -->
                    <div class="filter-section-label"><i class="fas fa-calendar"></i>Date</div>
                    <div class="filter-grid mb-3">
                        <div>
                            <label class="filter-label">Taken From</label>
                            <input type="date" class="form-control form-control-sm" name="dateTakenFrom"
                                   value="@(Model.AppliedFilters?.DateTakenFrom?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <label class="filter-label">Taken To</label>
                            <input type="date" class="form-control form-control-sm" name="dateTakenTo"
                                   value="@(Model.AppliedFilters?.DateTakenTo?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <label class="filter-label">Uploaded From</label>
                            <input type="date" class="form-control form-control-sm" name="dateUploadedFrom"
                                   value="@(Model.AppliedFilters?.DateUploadedFrom?.ToString("yyyy-MM-dd"))" />
                        </div>
                        <div>
                            <label class="filter-label">Uploaded To</label>
                            <input type="date" class="form-control form-control-sm" name="dateUploadedTo"
                                   value="@(Model.AppliedFilters?.DateUploadedTo?.ToString("yyyy-MM-dd"))" />
                        </div>
                    </div>

                    <hr class="filter-divider" />

                    <!-- Camera -->
                    @if (Model.AvailableCameras.Any())
                    {
                        <div class="filter-section-label"><i class="fas fa-camera"></i>Camera</div>
                        <div class="mb-3">
                            <select class="form-select form-select-sm" id="cameraSelect" multiple size="3">
                                @foreach (var camera in Model.AvailableCameras)
                                {
                                    <option value="@camera.Id"
                                            data-selected="@(Model.AppliedFilters?.CameraIds?.Contains(camera.Id) == true ? "true" : "false")">
                                        @camera.LocationName
                                    </option>
                                }
                            </select>
                            <input type="hidden" name="cameras" id="cameraIds" />
                            <small class="text-muted" style="font-size:0.65rem;">Ctrl/Cmd + click for multiple</small>
                        </div>
                        <hr class="filter-divider" />
                    }

                    <!-- Weather -->
                    <div class="filter-section-label"><i class="fas fa-cloud-sun"></i>Weather</div>
                    <div class="filter-note mb-2">
                        <i class="fas fa-info-circle me-1"></i>Data from <strong>@Model.PropertyName</strong> photos only.
                    </div>

                    <div class="filter-grid-3 mb-2">
                        <div>
                            <label class="filter-label">Temp °F</label>
                            <div class="filter-range">
                                <input type="number" class="form-control form-control-sm" name="tempMin" placeholder="Min" step="0.1" value="@Model.AppliedFilters?.TemperatureMin" />
                                <input type="number" class="form-control form-control-sm" name="tempMax" placeholder="Max" step="0.1" value="@Model.AppliedFilters?.TemperatureMax" />
                            </div>
                        </div>
                        <div>
                            <label class="filter-label">Wind mph</label>
                            <div class="filter-range">
                                <input type="number" class="form-control form-control-sm" name="windSpeedMin" placeholder="Min" step="0.1" value="@Model.AppliedFilters?.WindSpeedMin" />
                                <input type="number" class="form-control form-control-sm" name="windSpeedMax" placeholder="Max" step="0.1" value="@Model.AppliedFilters?.WindSpeedMax" />
                            </div>
                        </div>
                        <div>
                            <label class="filter-label">Humidity %</label>
                            <div class="filter-range">
                                <input type="number" class="form-control form-control-sm" name="humidityMin" placeholder="Min" step="0.1" value="@Model.AppliedFilters?.HumidityMin" />
                                <input type="number" class="form-control form-control-sm" name="humidityMax" placeholder="Max" step="0.1" value="@Model.AppliedFilters?.HumidityMax" />
                            </div>
                        </div>
                    </div>
                    <div class="filter-grid-3 mb-3">
                        <div>
                            <label class="filter-label">Pressure inHg</label>
                            <div class="filter-range">
                                <input type="number" class="form-control form-control-sm" name="pressureMin" placeholder="Min" step="0.01" value="@Model.AppliedFilters?.PressureMin" />
                                <input type="number" class="form-control form-control-sm" name="pressureMax" placeholder="Max" step="0.01" value="@Model.AppliedFilters?.PressureMax" />
                            </div>
                        </div>
                        <div>
                            <label class="filter-label">Visibility mi</label>
                            <div class="filter-range">
                                <input type="number" class="form-control form-control-sm" name="visibilityMin" placeholder="Min" step="0.1" value="@Model.AppliedFilters?.VisibilityMin" />
                                <input type="number" class="form-control form-control-sm" name="visibilityMax" placeholder="Max" step="0.1" value="@Model.AppliedFilters?.VisibilityMax" />
                            </div>
                        </div>
                        <div>
                            <label class="filter-label">Cloud Cover %</label>
                            <div class="filter-range">
                                <input type="number" class="form-control form-control-sm" name="cloudCoverMin" placeholder="Min" step="1" min="0" max="100" value="@Model.AppliedFilters?.CloudCoverMin" />
                                <input type="number" class="form-control form-control-sm" name="cloudCoverMax" placeholder="Max" step="1" min="0" max="100" value="@Model.AppliedFilters?.CloudCoverMax" />
                            </div>
                        </div>
                    </div>
                    <div class="filter-grid-3 mb-3">
                        <div>
                            <label class="filter-label">Moon Phase</label>
                            <select class="form-select form-select-sm" name="moonPhaseTexts" multiple size="3">
                                @foreach (var moonPhase in Model.AvailableMoonPhases)
                                {
                                    <option value="@moonPhase" selected="@(Model.AppliedFilters?.MoonPhaseTexts?.Contains(moonPhase) == true)">@moonPhase</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="filter-label">Conditions</label>
                            <select class="form-select form-select-sm" name="conditions" multiple size="3">
                                @foreach (var condition in Model.AvailableConditions)
                                {
                                    <option value="@condition" selected="@(Model.AppliedFilters?.Conditions?.Contains(condition) == true)">@condition</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="filter-label">Wind Direction</label>
                            <select class="form-select form-select-sm" name="windDirections" multiple size="3">
                                @foreach (var direction in Model.WindDirectionOptions.Where(d => d.IsAvailable))
                                {
                                    <option value="@direction.Value" selected="@(Model.AppliedFilters?.WindDirectionTexts?.Contains(direction.Value) == true)">@direction.DisplayName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="filter-actions">
                        <button type="submit" class="btn btn-custom-primary btn-sm">
                            <i class="fas fa-search me-1"></i>Apply Filters
                        </button>
                        @if (Model.HasFiltersApplied)
                        {
                            <a href="/properties/@Model.PropertyId/photos?sort=@Model.CurrentSort" class="btn btn-outline-secondary btn-sm">
                                <i class="fas fa-times me-1"></i>Clear All
                            </a>
                        }
                    </div>
                </form>

                <hr class="filter-divider mt-3" />

                <!-- Bulk Tagging -->
                <div id="taggingControls" class="tagging-controls-hidden">
                    <div class="tagging-panel">
                        <div class="tagging-panel-header">
                            <i class="fas fa-tags"></i>
                            Tag Selected
                            <span class="tagging-count" id="selectedCount">0</span>
                            photos
                        </div>
                        <div class="tagging-inputs">
                            <div>
                                <label class="filter-label">Existing Tag</label>
                                <select class="form-select form-select-sm" id="tagSelect">
                                    <option value="">Choose a tag...</option>
                                    @foreach (var tag in Model.AvailableTags)
                                    {
                                        <option value="@tag.Id">@tag.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="filter-label">New Tag</label>
                                <input type="text" class="form-control form-control-sm" id="newTagInput" placeholder="Enter tag name" />
                            </div>
                            <div class="d-flex align-items-end">
                                <button type="button" class="btn btn-custom-primary btn-sm w-100" id="addTagBtn">
                                    <i class="fas fa-plus me-1"></i>Add
                                </button>
                            </div>
                        </div>
                        <div class="tagging-bulk-actions">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="selectAllBtn">
                                <i class="fas fa-check-square me-1"></i>All
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="clearSelectionBtn">
                                <i class="fas fa-square me-1"></i>Clear
                            </button>
                        </div>
                    </div>
                </div>

                <div class="filter-note mt-2">
                    <i class="fas fa-info-circle me-1"></i>
                    <strong>Bulk:</strong> Check photos then tag above.
                    <strong>Single:</strong> Click any photo.
                </div>
            </div>
        </div>
    </div>

    <!-- Results bar -->
    <div class="results-bar">
        <span class="results-count">
            <span class="count-num">@Model.TotalPhotoCount</span> photos
            @if (Model.HasFiltersApplied)
            {
                <span class="results-filtered"><i class="fas fa-filter me-1"></i>Filtered</span>
            }
        </span>
        <div class="dropdown">
            <button class="sort-btn dropdown-toggle" type="button" data-bs-toggle="dropdown">
                <i class="fas fa-sort me-1"></i>Sort
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item @(Model.CurrentSort == "DateTakenDesc"    ? "active" : "")" href="@GetSortUrl("DateTakenDesc")">Newest First</a></li>
                <li><a class="dropdown-item @(Model.CurrentSort == "DateTakenAsc"     ? "active" : "")" href="@GetSortUrl("DateTakenAsc")">Oldest First</a></li>
                <li><a class="dropdown-item @(Model.CurrentSort == "DateUploadedDesc" ? "active" : "")" href="@GetSortUrl("DateUploadedDesc")">Uploaded (New)</a></li>
                <li><a class="dropdown-item @(Model.CurrentSort == "DateUploadedAsc"  ? "active" : "")" href="@GetSortUrl("DateUploadedAsc")">Uploaded (Old)</a></li>
            </ul>
        </div>
    </div>

    <!-- Photo groups -->
    @foreach (var group in Model.PhotoGroups)
    {
        <div class="mb-4">
            <div class="photo-month-header">
                <span>@group.MonthYear</span>
                <span class="photo-month-count">@group.Photos.Count photos</span>
            </div>
            <div class="photo-grid">
                @foreach (var photo in group.Photos)
                {
                    <div class="photo-card">
                        <div class="photo-img-wrap">
                            <input type="checkbox" class="photo-select photo-select-cb" value="@photo.Id" />
                            <img src="@photo.EncodedPhotoUrl"
                                 class="photo-thumb-img"
                                 alt="Photo from @photo.CameraLocationName"
                                 data-bs-toggle="modal"
                                 data-bs-target="#photoModal"
                                 data-photo-id="@photo.Id"
                                 data-photo-url="@photo.EncodedPhotoUrl"
                                 data-date-taken="@photo.DateTaken.ToString("MM/dd/yyyy h:mm tt")"
                                 data-date-uploaded="@photo.DateUploaded.ToString("MM/dd/yyyy h:mm tt")"
                                 data-camera-name="@photo.CameraLocationName"
                                 loading="lazy" />
                            <span class="photo-cam-badge">@photo.CameraLocationName</span>
                            <div class="photo-card-overlay"></div>
                        </div>
                        <div class="photo-card-footer">
                            <div class="photo-tags-area photo-tags-container" data-photo-id="@photo.Id">
                                <span class="photo-no-tags">Loading...</span>
                            </div>
                            <div class="photo-card-action">
                                <a href="/cameras/@photo.CameraId/details"
                                   class="btn btn-outline-secondary btn-sm"
                                   title="Camera Details"
                                   onclick="event.stopPropagation()">
                                    <i class="fas fa-eye" style="font-size:0.65rem;"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
</div>

<!-- Photo Modal -->
<div class="modal fade photo-modal" id="photoModal" tabindex="-1" aria-labelledby="photoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="photoModalLabel">Photo Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <img id="modalPhoto" src="" alt="Photo" class="photo-modal-img" />
                <div class="photo-modal-meta">
                    <div class="photo-meta-item">
                        <div class="photo-meta-label">Camera</div>
                        <div class="photo-meta-value" id="modalCameraName">—</div>
                    </div>
                    <div class="photo-meta-item">
                        <div class="photo-meta-label">Date Taken</div>
                        <div class="photo-meta-value" id="modalDateTaken">—</div>
                    </div>
                    <div class="photo-meta-item">
                        <div class="photo-meta-label">Uploaded</div>
                        <div class="photo-meta-value" id="modalDateUploaded">—</div>
                    </div>
                </div>
                <div class="photo-modal-tags-header"><i class="fas fa-tags me-2"></i>Tags</div>
                <div id="photoTags" class="mb-3">
                    <span class="text-muted">Loading tags...</span>
                </div>
                <div class="photo-modal-add-tag">
                    <div>
                        <label class="filter-label">Existing Tag</label>
                        <select class="form-select form-select-sm" id="modalTagSelect">
                            <option value="">Choose a tag...</option>
                            @foreach (var tag in Model.AvailableTags)
                            {
                                <option value="@tag.Id">@tag.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="filter-label">New Tag</label>
                        <input type="text" class="form-control form-control-sm" id="modalNewTagInput" placeholder="Tag name" />
                    </div>
                    <div class="d-flex align-items-end">
                        <button type="button" class="btn btn-custom-primary btn-sm w-100" id="modalAddTagBtn">
                            <i class="fas fa-plus"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPhotoId = null;

        document.addEventListener('DOMContentLoaded', function() {
            const photoModal = document.getElementById('photoModal');
            if (photoModal) document.body.appendChild(photoModal);
            initializeTagging();
            initializeFilterChevron();
            if (window.App && window.App.triggerMapLayerUpdate) {
                window.App.triggerMapLayerUpdate({ propertyId: @Model.PropertyId });
            }
        });

        function initializeFilterChevron() {
            const panel = document.getElementById('filtersPanel');
            const chevron = document.getElementById('filterChevron');
            if (!panel || !chevron) return;
            panel.addEventListener('show.bs.collapse', () => chevron.classList.add('open'));
            panel.addEventListener('hide.bs.collapse', () => chevron.classList.remove('open'));
        }

        function initializeTagging() {
            loadAllPhotoTags();
            initializeCameraFilter();
            document.addEventListener('change', e => {
                if (e.target.classList.contains('photo-select')) updateBulkControls();
            });
            document.getElementById('selectAllBtn')?.addEventListener('click', selectAllPhotos);
            document.getElementById('clearSelectionBtn')?.addEventListener('click', clearSelection);
            document.getElementById('addTagBtn')?.addEventListener('click', addTagToBulk);
            document.getElementById('modalAddTagBtn')?.addEventListener('click', addTagToSinglePhoto);
        }

        function initializeCameraFilter() {
            const sel = document.getElementById('cameraSelect');
            const inp = document.getElementById('cameraIds');
            if (!sel || !inp) return;
            sel.querySelectorAll('option').forEach(o => {
                if (o.getAttribute('data-selected') === 'true') o.selected = true;
            });
            const update = () => {
                inp.value = Array.from(sel.selectedOptions).map(o => o.value).filter(v => v?.trim()).join(',');
            };
            update();
            sel.addEventListener('change', update);
            document.getElementById('photoFiltersForm')?.addEventListener('submit', update);
        }

        async function loadAllPhotoTags() {
            for (const c of document.querySelectorAll('.photo-tags-container')) {
                const id = c.getAttribute('data-photo-id');
                if (id) await loadPhotoTagsForCard(parseInt(id), c);
            }
        }

        async function loadPhotoTagsForCard(photoId, container) {
            try {
                const r = await fetch(`/api/tags/photos/${photoId}`);
                if (r.ok) displayPhotoTagsInCard(await r.json(), container);
                else container.innerHTML = '<span class="photo-no-tags">No tags</span>';
            } catch { container.innerHTML = '<span class="photo-no-tags">No tags</span>'; }
        }

        function displayPhotoTagsInCard(tags, container) {
            container.innerHTML = tags.length === 0
                ? '<span class="photo-no-tags">No tags</span>'
                : tags.map(t => `<span class="photo-tag-badge">${t.name}</span>`).join('');
        }

        function updateBulkControls() {
            const count = document.querySelectorAll('.photo-select:checked').length;
            const controls = document.getElementById('taggingControls');
            const span = document.getElementById('selectedCount');
            if (!controls || !span) return;
            controls.classList.toggle('tagging-controls-hidden', count === 0);
            if (count > 0) span.textContent = count;
        }

        function selectAllPhotos() {
            document.querySelectorAll('.photo-select').forEach(cb => cb.checked = true);
            updateBulkControls();
        }

        function clearSelection() {
            document.querySelectorAll('.photo-select').forEach(cb => cb.checked = false);
            updateBulkControls();
        }

        async function addTagToBulk() {
            const photoIds = Array.from(document.querySelectorAll('.photo-select:checked')).map(cb => parseInt(cb.value));
            if (!photoIds.length) return alert('Please select photos to tag.');
            const tagSelect = document.getElementById('tagSelect');
            const newTagInput = document.getElementById('newTagInput');
            const tagName = newTagInput.value.trim() || (tagSelect.value ? tagSelect.options[tagSelect.selectedIndex].text : '');
            if (!tagName) return alert('Please select a tag or enter a new tag name.');
            try {
                const r = await fetch('/api/tags/photos/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                    body: JSON.stringify({ photoIds, tagName })
                });
                if (r.ok) { clearSelection(); newTagInput.value = ''; tagSelect.value = ''; location.reload(); }
                else alert('Error adding tag. Please try again.');
            } catch { alert('Error adding tag. Please try again.'); }
        }

        async function addTagToSinglePhoto() {
            if (!currentPhotoId) return;
            const tagSelect = document.getElementById('modalTagSelect');
            const newTagInput = document.getElementById('modalNewTagInput');
            const tagName = newTagInput.value.trim() || (tagSelect.value ? tagSelect.options[tagSelect.selectedIndex].text : '');
            if (!tagName) return alert('Please select a tag or enter a new tag name.');
            try {
                const r = await fetch('/api/tags/photos/add', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                    body: JSON.stringify({ photoIds: [currentPhotoId], tagName })
                });
                if (r.ok) { newTagInput.value = ''; tagSelect.value = ''; loadPhotoTags(currentPhotoId); }
                else alert('Error adding tag. Please try again.');
            } catch { alert('Error adding tag. Please try again.'); }
        }

        async function loadPhotoTags(photoId) {
            try {
                const r = await fetch(`/api/tags/photos/${photoId}`);
                if (r.ok) displayPhotoTags(await r.json());
                else document.getElementById('photoTags').innerHTML = '<span class="text-muted">Unable to load tags</span>';
            } catch { document.getElementById('photoTags').innerHTML = '<span class="text-muted">Error loading tags</span>'; }
        }

        function displayPhotoTags(tags) {
            const container = document.getElementById('photoTags');
            container.innerHTML = tags.length === 0
                ? '<span class="text-muted">No tags yet</span>'
                : tags.map(t => `<span class="badge badge-custom-secondary me-1 mb-1">${t.name}<button type="button" class="btn-close btn-close-white ms-1" onclick="removeTag(${t.id})" title="Remove tag"></button></span>`).join('');
        }

        async function removeTag(tagId) {
            if (!currentPhotoId) return;
            try {
                const r = await fetch('/api/tags/photos/remove', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
                    body: JSON.stringify({ photoIds: [currentPhotoId], tagId })
                });
                if (r.ok) loadPhotoTags(currentPhotoId);
                else alert('Error removing tag. Please try again.');
            } catch { alert('Error removing tag. Please try again.'); }
        }

        const photoModal = document.getElementById('photoModal');
        if (photoModal) {
            photoModal.addEventListener('show.bs.modal', function(event) {
                const btn = event.relatedTarget;
                currentPhotoId = parseInt(btn.getAttribute('data-photo-id'));
                const img = document.getElementById('modalPhoto');
                if (img) { img.src = btn.getAttribute('data-photo-url'); img.onerror = function() { this.alt = 'Failed to load photo'; }; }
                const el = id => document.getElementById(id);
                if (el('modalDateTaken'))    el('modalDateTaken').textContent    = btn.getAttribute('data-date-taken');
                if (el('modalDateUploaded')) el('modalDateUploaded').textContent = btn.getAttribute('data-date-uploaded');
                if (el('modalCameraName'))   el('modalCameraName').textContent   = btn.getAttribute('data-camera-name');
                loadPhotoTags(currentPhotoId);
            });
            photoModal.addEventListener('hidden.bs.modal', function() {
                const img = document.getElementById('modalPhoto');
                if (img) img.src = '';
                currentPhotoId = null;
            });
        }
    </script>
}
