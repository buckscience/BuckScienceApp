@{
    Layout = null;
    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration
    @inject BuckScience.Application.Abstractions.Auth.ICurrentUserService CurrentUser
    @inject BuckScience.Application.Abstractions.Services.ISubscriptionService SubscriptionService
    var sidebarClass = ViewBag.SidebarWide == true ? "sidebar-overlay sidebar-wide" : "sidebar-overlay";
    
    // Get user subscription tier for navigation visibility
    BuckScience.Domain.Enums.SubscriptionTier userTier = BuckScience.Domain.Enums.SubscriptionTier.Trial;
    if (CurrentUser.IsAuthenticated && CurrentUser.Id.HasValue)
    {
        userTier = await SubscriptionService.GetUserSubscriptionTierAsync(CurrentUser.Id.Value);
    }
    bool showPremiumFeatures = userTier >= BuckScience.Domain.Enums.SubscriptionTier.Doe && userTier != BuckScience.Domain.Enums.SubscriptionTier.Expired;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuckScience</title>
    
    <!-- Mapbox CSS -->
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.css" rel="stylesheet" />
    <link href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v4.7.2/mapbox-gl-geocoder.css" rel="stylesheet" />
    <link href="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v1.4.2/mapbox-gl-draw.css" rel="stylesheet" />
    <meta name="mapbox-token" content="@Configuration["Mapbox:AccessToken"]" />
    
    <!-- Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/weather-icons/2.0.12/css/weather-icons.min.css" rel="stylesheet" />
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    
    <!-- BuckScience Design System (includes Google Fonts) -->
    <link rel="stylesheet" href="~/css/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    
    @RenderSection("Styles", required: false)
</head>
<body>
    <!-- Mini Navbar with updated hunting theme -->
    <nav id="mini-navbar" class="bs-mini-nav">
        <div class="nav-top">
            <div class="nav-logo">
                <span class="nav-logo-icon">B</span>
                <span class="nav-logo-text">S</span>
            </div>
            <a href="/properties" title="Hunt Areas" class="nav-link">
                <i class="fas fa-map-marked"></i>
                <span>Hunt Areas</span>
            </a>
            @if (showPremiumFeatures)
            {
                <a href="/bucktrax" title="BuckTrax" class="nav-link nav-link-premium">
                    <i class="fas fa-route"></i>
                    <span>BuckTrax</span>
                </a>
                <a href="/buckcast" title="BuckCast" class="nav-link nav-link-premium">
                    <i class="fas fa-chart-line"></i>
                    <span>BuckCast</span>
                </a>
            }
        </div>
        <div class="nav-bottom">
            <a href="/account" title="Account" class="nav-link">
                <i class="fas fa-user-circle"></i>
                <span>Account</span>
            </a>
            <a href="/account/settings" title="Settings" class="nav-link">
                <i class="fas fa-gear"></i>
                <span>Settings</span>
            </a>
        </div>
    </nav>

    <!-- Sidebar where MVC views render -->
    <aside id="sidebar" class="@sidebarClass bs-sidebar">
        <div id="sidebar-content" class="bs-sidebar-content">
            @RenderBody()
        </div>
    </aside>

    <!-- Sidebar Toggle Button -->
    <button id="sidebar-toggle" class="btn bs-sidebar-toggle">
        <i class="fas fa-chevron-left"></i>
    </button>

    <!-- Map area -->
    <main class="map-area">
        <div id="map"></div>
        <div id="geocoder"></div>
    </main>

    <!-- Scripts -->
    <script src="https://api.mapbox.com/mapbox-gl-js/v2.15.0/mapbox-gl.js"></script>
    <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-geocoder/v4.7.2/mapbox-gl-geocoder.min.js"></script>
    <script src="https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-draw/v1.4.2/mapbox-gl-draw.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.js"></script>
    <script src="~/js/map-init.js"></script>
    <script src="~/js/navbar.js"></script>
    <script src="~/js/sidebar.js"></script>
    <script src="~/js/feature-utils.js"></script>
    <script src="~/js/properties.js"></script>
    <script src="~/js/bucklens-charts.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>